    "ViVuView không lưu thumbnail hay bộ nhớ đệm ra đĩa.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ViVuView schreibt nie Miniaturen oder Caches auf die Festplatte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ViVuView never writes thumbnails or caches to disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ViVuView nunca guarda miniaturas ni cachés en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ViVuView n’écrit jamais de vignettes ni de cache sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ViVuView non scrive mai miniature o cache su disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ViVuViewはサムネイルやキャッシュをディスクに書き込みません。"
