          "stringUnit": {
            "state": "translated",
            "value": "Sposta ViVuView nella cartella Applicazioni prima di associare i formati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットを関連付ける前に、ViVuViewを“アプリケーション”フォルダに移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
