    "Kéo ảnh vào đây, nhấn đúp hoặc ⌘O để mở": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild hierher ziehen, doppelklicken oder ⌘O drücken zum Öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop an image here, double-click or press ⌘O to open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una imagen aquí, haz doble clic o pulsa ⌘O para abrir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez une image ici, double-cliquez ou appuyez sur ⌘O pour ouvrir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina qui un'immagine, fai doppio clic o premi ⌘O per aprire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに画像をドロップ、またはダブルクリックか ⌘O で開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 여기로 드래그하거나, 이중 클릭 또는 ⌘O를 눌러 열기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte uma imagem aqui, clique duas vezes ou pressione ⌘O para abrir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите изображение сюда, дважды нажмите или нажмите ⌘O"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo ảnh vào đây, nhấn đúp hoặc ⌘O để mở"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图片拖到此处，或连按、按下 ⌘O 以打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將圖片拖移至此，或按兩下、按下 ⌘O 來打開"
