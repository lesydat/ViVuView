    "Bạn cũng có thể đổi trong Finder: chọn file → Get Info → Open with → Change All.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dies auch im Finder ändern: Datei auswählen → Informationen → Öffnen mit → Alle ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also change this in Finder: select a file → Get Info → Open with → Change All."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes cambiarlo en Finder: selecciona un archivo → Obtener información → Abrir con → Cambiar todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi le modifier dans le Finder : sélectionnez un fichier → Lire les informations → Ouvrir avec → Tout modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificarlo anche nel Finder: seleziona un file → Ottieni informazioni → Apri con → Modifica tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderでも変更できます：ファイルを選択 → 情報を見る → このアプリケーションで開く → すべてを変更…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서도 변경할 수 있습니다: 파일 선택 → 정보 가져오기 → 다음으로 열기 → 모두 변경."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode alterar isso no Finder: selecione um arquivo → Obter Informações → Abrir com → Alterar Tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это также можно изменить в Finder: выберите файл → Свойства → Открыть в программе → Изменить все."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cũng có thể đổi trong Finder: chọn file → Get Info → Open with → Change All."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在访达中更改：选择一个文件 → 显示简介 → 打开方式 → 全部更改…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在 Finder 中更改：選取一個檔案 → 取得資訊 → 打開檔案的應用程式 → 全部更改…"
          }
        }
      }
    },
