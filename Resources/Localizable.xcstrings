    "%lld loại không đổi được (có thể bạn đã từ chối hộp thoại hệ thống).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Typen konnten nicht geändert werden (der Systemdialog wurde eventuell abgelehnt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld types could not be changed (the system dialog may have been declined)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cambiar %lld tipos (puede que se rechazara el cuadro de diálogo del sistema)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld types n’ont pas pu être modifiés (la boîte de dialogue système a peut-être été refusée)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare %lld tipi (la finestra di sistema potrebbe essere stata rifiutata)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 種類のファイルを変更できませんでした（システムのダイアログが拒否された可能性があります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 유형을 변경할 수 없습니다(시스템 대화상자를 거부했을 수 있습니다)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar %lld tipos (o diálogo do sistema pode ter sido recusado)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить типов: %lld (возможно, системный запрос был отклонен)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld loại không đổi được (có thể bạn đã từ chối hộp thoại hệ thống)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 种类型未能更改（你可能拒绝了系统对话框）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 種類型無法更改（你可能拒絕了系統對話框）。"
          }
        }
      }
    },
