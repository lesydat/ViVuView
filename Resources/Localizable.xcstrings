    "Hãy chuyển ViVuView vào thư mục Applications trước khi gắn định dạng.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege ViVuView in den Ordner „Programme“, bevor du Formate zuordnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move ViVuView to the Applications folder before associating formats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traslada ViVuView a la carpeta Aplicaciones antes de asociar formatos."
          }
        },
